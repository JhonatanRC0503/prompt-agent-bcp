# Copia a orchestrator/.env y ajusta.    cp orchestrator/.env.example orchestrator/.env
#
# VM o local  -> este archivo es la configuración.
# App Service -> mandan los app settings; el zip de despliegue excluye .env.
# Las variables que ya estén en el entorno ganan sobre este archivo.

# Obligatoria. El resto tiene valor por defecto y puedes borrar lo que no cambies.
FOUNDRY_PROJECT_ENDPOINT=https://aaifs1rmiad02.services.ai.azure.com/api/projects/prj_aaifs1rmiad02

# Modelo del orquestador: solo extrae entidades y enruta preguntas.
MODELO_ORQUESTADOR=gpt-4.1-mini

# Prompt agents publicados en Foundry. Se invocan por nombre, siempre su última versión.
AGENTE_FINANCIERO=financiero
AGENTE_SECTORIAL=sectorial
AGENTE_REPORTES_PREVIOS=reportes-previos
AGENTE_GENERADOR=generador-reporte

# Lectura de los PDFs adjuntos con prebuilt-layout: devuelve las tablas estructuradas y hace OCR.
# Sin esto se cae a pypdf, que pierde las tablas y no lee escaneados.
# Requiere el rol "Cognitive Services User" sobre el recurso (ver roles.md).
DOCUMENT_INTELLIGENCE_ENDPOINT=https://aidieu2rmiad02.cognitiveservices.azure.com/

# Contenedor para el snapshot de sesiones. La cuenta se resuelve por las conexiones de Foundry.
CONTENEDOR_SESIONES=sesiones

# Segundos por invocación a un agente (tardan 77-85 s en condiciones normales).
TIMEOUT_AGENTE=420

MAX_BYTES_ADJUNTO=20971520
MAX_CHARS_ADJUNTO=60000
LOG_LEVEL=INFO

# Solo si la VM usa identidad asignada por el usuario en vez de system-assigned.
# AZURE_CLIENT_ID=
